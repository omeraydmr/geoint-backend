# STRATYON Backend - Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git!

# Application
ENVIRONMENT=development
DEBUG=false

# Database (PostgreSQL + PostGIS)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=stratyon
POSTGRES_PASSWORD=your-secure-password
POSTGRES_DB=stratyon_db

# Redis (caching)
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=generate-random-64-char-string-here
JWT_SECRET_KEY=generate-random-64-char-string-here

# OpenAI
OPENAI_API_KEY=sk-proj-your-key

# Anthropic (Claude)
ANTHROPIC_API_KEY=sk-ant-api03-your-key

# Google Ads
GOOGLE_ADS_DEVELOPER_TOKEN=your-token
GOOGLE_ADS_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_ADS_CLIENT_SECRET=your-secret
GOOGLE_ADS_REFRESH_TOKEN=your-refresh-token
GOOGLE_ADS_CUSTOMER_ID=your-customer-id

# Meta (Facebook) Ads
META_ACCESS_TOKEN=your-token
META_APP_ID=your-app-id
META_APP_SECRET=your-secret
META_AD_ACCOUNT_ID=act_XXXXXXXXX

# DataForSEO
DATAFORSEO_LOGIN=your-login
DATAFORSEO_PASSWORD=your-password

# Mapbox (used by backend for geocoding if needed)
MAPBOX_ACCESS_TOKEN=pk.your-token
